# Copy this file to `.env` and fill in the real values. `.env` is gitignored;
# this example never holds a secret.
#
# Every variable the backend actually reads is listed here. The ones marked
# REQUIRED have no safe default — the server either refuses to start or throws on
# the first send without them.

# ---- Database (REQUIRED) ----
# Points at the PostgreSQL container from docker-compose.yml at the repo root, so
# the user/password/db here must match the DB_USER / DB_PASSWORD / DB_NAME in the
# root .env that Compose reads.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/mailhub?schema=public"

# Port the API listens on. Default 4000.
BACKEND_PORT=4000

# ---- Amazon SES (REQUIRED to send anything) ----
# Region matters more than it looks: domain verification, DKIM and production
# access are all PER REGION, and AWS can disable sending in one region while
# leaving others healthy. Check SES Console -> Account dashboard before choosing.
# For this project the answer is us-east-1 (see PROGRESS.md).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# The From address. REQUIRED — src/email/ses.ts throws on the first send if it is
# empty, and that failure only shows up when someone presses Send. It must be an
# address on a domain (or an address) verified in the region above.
SES_FROM=no-reply@example.com

# The SES configuration set every send is tagged with. This is what makes AWS
# publish bounce/complaint events to our SNS topic, which POSTs them to
# /webhooks/ses, which suppresses the address and re-checks auto-pause.
#
# Leave it unset in local development (no SNS topic there, so nothing to route
# to). On a server, leaving it unset is a silent failure: mail sends perfectly
# and no bounce or complaint is ever recorded, so a dead address stays on the
# list and keeps being emailed. Optional in the sense that sending works
# without it; required in the sense that bounce handling does not.
#
# Set it up in AWS first (SNS topic -> SES configuration set -> event
# destination -> topic access policy), then put the set's name here.
SES_CONFIGURATION_SET=

# ---- Public URL (REQUIRED on a server) ----
# The address this backend is reachable at FROM THE OUTSIDE. Every unsubscribe
# link, open pixel and tracked link in an email points here, and they are opened
# days later from someone else's inbox.
#
# Leave it unset in local development and it falls back to localhost, which is
# fine for you and broken for everyone else. On a server, getting this wrong is
# not cosmetic: tracking records nothing, and Gmail's one-click unsubscribe POSTs
# into the void — so a client who unsubscribes is never suppressed and keeps
# being emailed.
PUBLIC_URL=https://mail.example.com

# ---- Auto-pause (circuit breaker) — all optional ----
# Sending stops for a brand when bounce/complaint rates spike, until a person
# resumes it. These are EMERGENCY levels and sit deliberately looser than the
# targets shown on the Analytics screen (bounce 5%, complaint 0.1%): at the 0.1%
# target a single complaint in an 800-person send would halt the company.
# Defaults are in src/email/auto-pause.ts; set these only to override.
#AUTOPAUSE_WINDOW_DAYS=7
#AUTOPAUSE_MIN_SENT=50
#AUTOPAUSE_MIN_EVENTS=2
#AUTOPAUSE_BOUNCE_RATE=0.05
#AUTOPAUSE_COMPLAINT_RATE=0.003

# ---- Development only ----
# Skips SNS signature verification on /webhooks/ses so bounce/complaint payloads
# can be posted by hand. NEVER set this on a server: the webhook auto-suppresses
# addresses, so anyone who found the URL could unsubscribe your whole list.
#SNS_SKIP_VERIFY=true
