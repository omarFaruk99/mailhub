// Prisma schema — this describes our database tables.
// The database URL lives in prisma.config.ts (Prisma 7 rule).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// A brand = one product with its own clients & sender identity.
model Brand {
  id        String    @id @default(uuid())
  name      String
  domain    String    @unique
  createdAt DateTime  @default(now())

  contacts     Contact[]
  campaigns    Campaign[]
  suppressions Suppression[]
  templates    Template[]
}

// A template = a saved, reusable email design (name + HTML body).
// Users start from a ready-made design or write HTML, edit it with a live preview,
// and save. `category` is the default send-category to preselect in a campaign.
// html may contain {{name}} merge tags (replaced per recipient at send time).
model Template {
  id        String   @id @default(uuid())
  name      String
  subject   String   @default("")
  category  String   @default("") // default send category (e.g. "Product updates")
  html      String
  isStarter Boolean  @default(false) // true = system-seeded ready-made; false = user's own
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brandId   String
  brand     Brand    @relation(fields: [brandId], references: [id])

  // One template name per brand (no duplicates within a brand).
  @@unique([brandId, name])
}

// A contact = one person of a brand (client, prospect, or internal colleague).
model Contact {
  id        String   @id @default(uuid())
  email     String
  name      String?
  country   String?
  plan      String?  // e.g. Paid / Trial / Free
  type      String   @default("client")  // client | prospect | internal (internal = our own colleagues)
  company   String?  // external company name, used for filtering (blank for internal/individuals)
  status    String   @default("subscribed") // subscribed | unsubscribed | bounced
  createdAt DateTime @default(now())

  brandId   String
  brand     Brand    @relation(fields: [brandId], references: [id])

  recipients CampaignRecipient[]

  // RULE: one email = one contact, per brand (no duplicates within a brand).
  @@unique([brandId, email])
}

// A campaign = one email blast for a brand.
model Campaign {
  id        String   @id @default(uuid())
  name      String
  category  String   // Product updates | Marketing/Offers | Tips & Onboarding | Transactional
  subject   String
  html      String
  status    String   @default("draft") // draft | scheduled | sending | sent
  createdAt DateTime @default(now())

  // --- Scheduling (send later) ---
  // scheduledAt is the absolute UTC instant the send must happen. timezone is the
  // IANA zone the user picked (kept only so the UI can show the time they chose).
  // sendOptions freezes the audience/filter at schedule time, because the send runs
  // later without anyone on screen. jobId is the pg-boss job, so it can be cancelled.
  scheduledAt DateTime?
  timezone    String?
  sendOptions Json?
  jobId       String?

  brandId   String
  brand     Brand    @relation(fields: [brandId], references: [id])

  recipients CampaignRecipient[]
}

// One row per (campaign, contact) that was sent — gives exactly-once + history.
model CampaignRecipient {
  id         String    @id @default(uuid())
  email      String
  status     String    @default("sent") // sent | failed
  messageId  String?
  sentAt     DateTime  @default(now())
  openedAt   DateTime? // set when the tracking pixel loads
  clickedAt  DateTime? // set when a tracked link is clicked

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  contactId  String
  contact    Contact  @relation(fields: [contactId], references: [id])

  // RULE: exactly-once — a contact gets a given campaign only once.
  @@unique([campaignId, contactId])
}

// Suppression = emails we must NOT send to (per brand).
model Suppression {
  id        String   @id @default(uuid())
  email     String
  reason    String   // unsubscribe | bounce | complaint
  createdAt DateTime @default(now())

  brandId   String
  brand     Brand    @relation(fields: [brandId], references: [id])

  @@unique([brandId, email])
}
