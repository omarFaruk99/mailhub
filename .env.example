# ---- Copy this file to ".env" and fill real values. NEVER commit .env ----

# Database (PostgreSQL runs in Docker)
DB_USER=mailhub
DB_PASSWORD=change_me_to_a_strong_password
DB_NAME=mailhub
DB_PORT=5432

# Backend
BACKEND_PORT=4000
APP_URL=http://localhost:3000

# The backend's public address, as the FRONTEND's browser code should call it.
# Baked into the frontend build at build time (see frontend/Dockerfile) — only
# needed for a server deploy behind nginx; local dev falls back to
# http://localhost:4000 (see frontend/src/lib/api.ts).
NEXT_PUBLIC_API_URL=

# The address this backend is reachable at FROM THE OUTSIDE WORLD.
# Every unsubscribe link, open pixel and tracked link inside an email points here,
# and those are opened days later from someone else's inbox — so on the server this
# MUST be the real public URL (e.g. https://mail.innovatesolution.com).
# "localhost" would resolve to the recipient's own computer and the link would break.
# Leave unset in local dev: it falls back to http://localhost:BACKEND_PORT.
PUBLIC_URL=

# ---- Auto-pause (circuit breaker) ----
# Sending stops automatically when bounces/complaints spike. All optional — these
# are the defaults, shown so they can be tuned without reading the code.
# These are EMERGENCY levels, looser than the targets on the Analytics screen:
# a pause halts the company's email until a person resumes it, so it must fire on
# a real problem, not on a bad day.
# AUTOPAUSE_WINDOW_DAYS=7        # rolling window the rates are measured over
# AUTOPAUSE_MIN_SENT=50          # below this many emails in the window, never pause
#                                # (2 bounces out of 3 test sends is 67% and means nothing)
# AUTOPAUSE_MIN_EVENTS=2         # never pause on a single bounce/complaint
# AUTOPAUSE_BOUNCE_RATE=0.05     # 5% — same as the target; SES itself acts near here
# AUTOPAUSE_COMPLAINT_RATE=0.003 # 0.3% — where Gmail/Yahoo actually penalise a sender.
#                                # The 0.1% target stays on the Analytics screen; at
#                                # 0.1% a SINGLE complaint in an 800-person send
#                                # (0.125%) would stop everything.

# ---- Filled in later steps ----

# Amazon SES (Step 5)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Cloudflare R2 (later)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
