# Secrets — NEVER commit.
# Every .env variant, not just the two we happen to use today: a backup made
# while debugging (".env.backup", ".env.old") holds the same live AWS keys, and
# one `git add -A` would publish them. .env.example is the only one allowed.
.env
.env.*
!.env.example
*.pem

# Dependencies
node_modules/

# Build output
dist/
build/
.next/
out/

# Generated Prisma client
**/generated/

# Logs & OS
*.log
.DS_Store
Thumbs.db

# Playwright MCP scratch output (screenshots, page snapshots)
.playwright-mcp/
